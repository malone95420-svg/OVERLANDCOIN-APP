# Optional BlockDAG RPC overrides
NEXT_PUBLIC_BLOCKDAG_RPC=https://rpc.west.bdag-us.org/
NEXT_PUBLIC_BLOCKDAG_RPC_FALLBACK=https://rpc.bdagscan.com/
# Also referenced: https://rpc.blockdag.engineering/

# Site URL for absolute OG/metadata (set in production)
NEXT_PUBLIC_SITE_URL=https://overlandcoin.com

# --- Wallet / presale ---
# Optional WalletConnect Cloud project id. If unset, only injected wallets (MetaMask, etc.) work.
# Never paste an API key into the site UI — set this in deployment env only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# BDAG/USD estimate for native BDAG purchases (not a live oracle). Default 0.05 if unset.
NEXT_PUBLIC_BDAG_USD_PRICE=0.05

# Optional ERC-20 pay tokens on BlockDAG (leave empty to hide).
# Official BDUSD is hardcoded in the app: 0x35ABC7f6Cdcd2eB99a7A6e6D1169bf915d972a1b
# Do not invent unofficial USDT/USDC/WETH addresses.
# NEXT_PUBLIC_PAY_TOKEN_USDT=
# NEXT_PUBLIC_PAY_TOKEN_USDC=
# NEXT_PUBLIC_PAY_TOKEN_ETH=

# RANGER assistant (optional — v1 is local/rule-based; no key required)
# RANGER_API=https://your-llm-gateway.example/v1/chat
# RANGER_API_KEY=  # server-only when LLM wiring is added — never expose to the browser
