# Optional BlockDAG RPC overrides
NEXT_PUBLIC_BLOCKDAG_RPC=https://rpc.west.bdag-us.org/
NEXT_PUBLIC_BLOCKDAG_RPC_FALLBACK=https://rpc.bdagscan.com/
# Also referenced: https://rpc.blockdag.engineering/

# Site URL for absolute OG/metadata (set in production)
NEXT_PUBLIC_SITE_URL=https://overlandcoin.com

# RANGER assistant (optional — v1 is local/rule-based; no key required)
# RANGER_API=https://your-llm-gateway.example/v1/chat
# RANGER_API_KEY=  # server-only when LLM wiring is added — never expose to the browser
