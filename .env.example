# Optional BlockDAG RPC overrides
NEXT_PUBLIC_BLOCKDAG_RPC=https://rpc.west.bdag-us.org/
NEXT_PUBLIC_BLOCKDAG_RPC_FALLBACK=https://rpc.east.bdag-us.org/
# west + east = send-capable (use for MetaMask / wallet_addEthereumChain).
# engineering = read-only / no-send (good tip for receipts; eth_sendRawTransaction missing).
# Built-in read list also includes engineering; never put it in wallet rpcUrls.
# Do NOT use https://rpc.bdagscan.com/ as JSON-RPC (stale/divergent tip).
# Explorer UI https://bdagscan.com is fine.

# Site URL for absolute OG/metadata (set in production)
NEXT_PUBLIC_SITE_URL=https://overlandcoin.com

# --- Quest OLC reward payouts (server-only) ---
# Hot wallet that sends ERC-20 OLC on successful claim. NEVER expose to the browser.
# Fund this address with OLC on BlockDAG 1404 before enabling live claims.
# REWARD_PRIVATE_KEY=0xYOUR_64_HEX_CHARS
# Optional RPC override for payouts (falls back to BlockDAG public RPCs):
# REWARD_RPC_URL=https://rpc.west.bdag-us.org/  # or https://rpc.east.bdag-us.org/
# If REWARD_PRIVATE_KEY is unset, POST /api/rewards/claim returns 503 and the UI stays in demo mode
# (pending_claim only — no fake on-chain success).

# --- Wallet / presale ---
# Optional WalletConnect Cloud project id. If unset, only multi-injected wallets work
# (OKX, Trust, Rabby, Coinbase, Bitget, MetaMask/Browser). Do not enable MetaMask SDK.
# Wallets must use BlockDAG 1404 with send-capable RPC (west/east) for on-chain Buy.
# Never paste an API key into the site UI — set this in deployment env only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional stale BDAG/USD display estimate only (never used as primary Buy rate).
# Buy requires a fresh live rate from /api/prices (CoinGecko / LBank / P2B / CoinPaprika).
# NEXT_PUBLIC_BDAG_USD_PRICE=0.05

# Optional BlockDAG ERC-20 pay tokens (leave empty to hide on-chain path).
# Official BDUSD is hardcoded: 0x35ABC7f6Cdcd2eB99a7A6e6D1169bf915d972a1b
# Do not invent unofficial USDT/USDC/WETH addresses.
# NEXT_PUBLIC_PAY_TOKEN_USDT=
# NEXT_PUBLIC_PAY_TOKEN_USDC=
# NEXT_PUBLIC_PAY_TOKEN_ETH=

# External deposit addresses for accepted majors (BTC / ETH / USDT / USDC / SOL).
# Code defaults enable ETH/USDT/USDC on Ethereum + SOL on Solana without env; set these
# in Vercel Production to match (or override). PresaleBuy records pending_external purchases.
NEXT_PUBLIC_DEPOSIT_BTC=bc1qp6m0apc0mx6y88xw3ustezwaf7wfyvhvurs9ug
NEXT_PUBLIC_DEPOSIT_BTC_NETWORK=Bitcoin (native SegWit)
NEXT_PUBLIC_DEPOSIT_ETH=0x310a612db74456cbc25a1f4f86fa0c265d98af99
NEXT_PUBLIC_DEPOSIT_ETH_NETWORK=Ethereum
NEXT_PUBLIC_DEPOSIT_USDT=0x310a612db74456cbc25a1f4f86fa0c265d98af99
NEXT_PUBLIC_DEPOSIT_USDT_NETWORK=Ethereum
NEXT_PUBLIC_DEPOSIT_USDC=0x310a612db74456cbc25a1f4f86fa0c265d98af99
NEXT_PUBLIC_DEPOSIT_USDC_NETWORK=Ethereum
NEXT_PUBLIC_ACCEPT_SOL=1
NEXT_PUBLIC_DEPOSIT_SOL=FEUnNerfhepyz2fR7Dg5gV59hxpJ92VYg9Yv9LbmP5tJ
# NEXT_PUBLIC_DEPOSIT_SOL_NETWORK=Solana
# NEXT_PUBLIC_ACCEPT_BNB=0
# NEXT_PUBLIC_DEPOSIT_BNB=

# RANGER assistant (optional — v1 is local/rule-based; no key required)
# RANGER_API=https://your-llm-gateway.example/v1/chat
# RANGER_API_KEY=  # server-only when LLM wiring is added — never expose to the browser

# --- Presale locked delivery (PresaleLock on BlockDAG 1404) ---
# Deploy contracts/PresaleLock.sol, fund with OLC, setOperator to the deliver wallet.
# NEXT_PUBLIC_PRESALE_LOCK_ADDRESS=0xYourPresaleLockAddress
# Server key that calls PresaleLock.credit (operator). Falls back to REWARD_PRIVATE_KEY if unset.
# PRESALE_DELIVER_PRIVATE_KEY=0xYOUR_64_HEX_CHARS
# Optional RPC for deliver txs (falls back to REWARD_RPC_URL / public BlockDAG RPCs):
# PRESALE_RPC_URL=https://rpc.west.bdag-us.org/  # or https://rpc.east.bdag-us.org/
# If lock address or key is missing, buys are marked locked_pending_chain after payment verify
# (local locked credit only — still requires a verified paymentTxHash).

# --- Payment verification (auto-confirm before PresaleLock credit) ---
# Optional Ethereum JSON-RPC for ETH/USDT/USDC deposit verification (public fallbacks used if unset):
# ETHEREUM_RPC_URL=https://ethereum.publicnode.com
# Optional Solana JSON-RPC for SOL deposit verification:
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional cron secret for GET/POST /api/cron/presale-scan (Vercel cron every 10m).
# If unset, the cron route no-ops. Set the same value in Vercel Cron auth / Authorization Bearer.
# CRON_SECRET=


# --- Auth (Auth.js / next-auth v5) ---
# Required for signed JWT sessions in production. Generate: openssl rand -base64 32
AUTH_SECRET=
# Canonical site URL for Auth.js callbacks (Vercel: set to your deployment URL)
# AUTH_URL=https://overlandcoin-app-kohl.vercel.app
# NEXTAUTH_URL is accepted as an alias by Auth.js:
# NEXTAUTH_URL=https://overlandcoin-app-kohl.vercel.app
# On Vercel, trustHost is enabled in code; AUTH_TRUST_HOST=true is optional.
# AUTH_TRUST_HOST=true

# Optional Google OAuth (only shown when both are set)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional Upstash Redis — required for durable email/password register in production.
# Without these, wallet login still works; email register returns a friendly error.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
