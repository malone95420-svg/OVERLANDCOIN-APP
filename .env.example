# Optional BlockDAG RPC overrides
NEXT_PUBLIC_BLOCKDAG_RPC=https://rpc.west.bdag-us.org/
NEXT_PUBLIC_BLOCKDAG_RPC_FALLBACK=https://rpc.bdagscan.com/
# Also referenced: https://rpc.blockdag.engineering/

# Site URL for absolute OG/metadata (set in production)
NEXT_PUBLIC_SITE_URL=https://overlandcoin.com

# --- Quest OLC reward payouts (server-only) ---
# Hot wallet that sends ERC-20 OLC on successful claim. NEVER expose to the browser.
# Fund this address with OLC on BlockDAG 1404 before enabling live claims.
# REWARD_PRIVATE_KEY=0xYOUR_64_HEX_CHARS
# Optional RPC override for payouts (falls back to BlockDAG public RPCs):
# REWARD_RPC_URL=https://rpc.west.bdag-us.org/
# If REWARD_PRIVATE_KEY is unset, POST /api/rewards/claim returns 503 and the UI stays in demo mode
# (pending_claim only — no fake on-chain success).

# --- Wallet / presale ---
# Optional WalletConnect Cloud project id. If unset, only injected wallets (MetaMask, etc.) work.
# Never paste an API key into the site UI — set this in deployment env only.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional stale BDAG/USD display estimate only (never used as primary Buy rate).
# Buy requires a fresh live rate from /api/prices (CoinGecko / LBank / P2B / CoinPaprika).
# NEXT_PUBLIC_BDAG_USD_PRICE=0.05

# Optional BlockDAG ERC-20 pay tokens (leave empty to hide on-chain path).
# Official BDUSD is hardcoded: 0x35ABC7f6Cdcd2eB99a7A6e6D1169bf915d972a1b
# Do not invent unofficial USDT/USDC/WETH addresses.
# NEXT_PUBLIC_PAY_TOKEN_USDT=
# NEXT_PUBLIC_PAY_TOKEN_USDC=
# NEXT_PUBLIC_PAY_TOKEN_ETH=

# Optional external deposit addresses for accepted majors (BTC / ETH / USDT / USDC).
# When set, PresaleBuy shows "Pay with {symbol}" + instructions and records a pending_external purchase.
# NEXT_PUBLIC_DEPOSIT_BTC=
# NEXT_PUBLIC_DEPOSIT_BTC_NETWORK=Bitcoin
# NEXT_PUBLIC_DEPOSIT_ETH=
# NEXT_PUBLIC_DEPOSIT_ETH_NETWORK=Ethereum
# NEXT_PUBLIC_DEPOSIT_USDT=
# NEXT_PUBLIC_DEPOSIT_USDT_NETWORK=
# NEXT_PUBLIC_DEPOSIT_USDC=
# NEXT_PUBLIC_DEPOSIT_USDC_NETWORK=
# NEXT_PUBLIC_ACCEPT_SOL=0
# NEXT_PUBLIC_DEPOSIT_SOL=
# NEXT_PUBLIC_ACCEPT_BNB=0
# NEXT_PUBLIC_DEPOSIT_BNB=

# RANGER assistant (optional — v1 is local/rule-based; no key required)
# RANGER_API=https://your-llm-gateway.example/v1/chat
# RANGER_API_KEY=  # server-only when LLM wiring is added — never expose to the browser

# --- Presale locked delivery (PresaleLock on BlockDAG 1404) ---
# Deploy contracts/PresaleLock.sol, fund with OLC, setOperator to the deliver wallet.
# NEXT_PUBLIC_PRESALE_LOCK_ADDRESS=0xYourPresaleLockAddress
# Server key that calls PresaleLock.credit (operator). Falls back to REWARD_PRIVATE_KEY if unset.
# PRESALE_DELIVER_PRIVATE_KEY=0xYOUR_64_HEX_CHARS
# Optional RPC for deliver txs (falls back to REWARD_RPC_URL / public BlockDAG RPCs):
# PRESALE_RPC_URL=https://rpc.west.bdag-us.org/
# If lock address or key is missing, buys are marked locked_pending_chain (local locked credit only).

